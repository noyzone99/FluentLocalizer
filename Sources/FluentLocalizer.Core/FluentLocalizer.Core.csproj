<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>FluentLocalizer</PackageId>
		<Product>FluentLocalizer</Product>
		<RootNamespace>FluentLocalizer</RootNamespace>
		<Version>1.2.0</Version>
		<Description>
			Core library for building culture-aware translation pipelines in .NET with fluent APIs, ICU message syntax, and configurable fallback and error handling.
		</Description>
		<PackageReleaseNotes>Add optional catalog culture reporting for ICU plurals and ordinals. Fix exception policies, concurrent option reads, Unicode casing and fallback tokens. Reuse ICU formatters with bounded caches.</PackageReleaseNotes>
		<PackageTags>localization;translation;icu;messageformat;culture;fluent;dotnet</PackageTags>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MessageFormat" Version="8.0.0" />
	</ItemGroup>

	<Import Project="..\FluentLocalizer.Shared.Polyfill\FluentLocalizer.Shared.Polyfill.projitems" Label="Shared" />

</Project>
